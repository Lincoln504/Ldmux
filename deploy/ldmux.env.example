# Copy to ~/.config/ldmux/env (the unit reads it if it exists), then edit.
# Plain KEY=VALUE lines: no quotes, no `export`, no comments after a value.
#
# Nothing in this file is required. Every variable has a default, and a variable that
# is absent turns its feature off rather than breaking the daemon: a malformed mesh
# setting disables the mesh and says so, and the shells keep running.

# ── Reachability ─────────────────────────────────────────────────────────────

# The tailnet address the phone connects to (`tailscale ip -4`). Must be a tailnet or
# loopback address: the daemon refuses anything else, so a mistake here is a message at
# startup, not a listener on the open internet. Unset means loopback only, which the CLI
# and desk windows can still use and a phone cannot.
#LDMUX_REMOTE_HOST=

# The port the phone connects to. Default 7623; a phone paired against a different port
# keeps needing that port, which is why it can be set here instead of re-pairing.
#LDMUX_REMOTE_PORT=7623

# ── The radio route (optional) ───────────────────────────────────────────────
#
# `docs/ARCHITECTURE.md` section 11 is the procedure. One MeshCore companion radio on the
# host (over USB) and one on the phone (over Bluetooth LE), both on the same tuple.

# The host's radio, by its stable device path. **This is the serial topology**: the daemon
# opens the port, reads the tuple from the radio and owns it, so no gateway process runs.
# Find it under /dev/serial/by-id/. Unset means no radio route on this host, and nothing
# else about the daemon changes.
#LDMUX_MESH_SERIAL=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_XXXX-if00

# The pairing's pre-shared key, 64 hex characters. This is the one secret a phone and this
# host must share, and it is what makes the radio route private: the records are sealed
# under it. `ldmux mesh` does not generate one; any 32 random bytes are a valid key
# (`openssl rand -hex 32`), and the same value must reach the phone in the pairing code.
# It is persisted to mesh-psk (0600) in the persist directory, so it only has to be given
# once; unset with no stored key means the session layer is off and the mesh link says so.
#LDMUX_MESH_PSK=

# This host's radio public key (64 hex). **Optional now**: a daemon that owns its radio
# reads the key from the radio itself, and a pairing code made by it carries the key.
# Set it only to pin a key the daemon cannot read (a gateway, or a radio whose key you
# want frozen). A code with no host radio key cannot be used by a phone.
#LDMUX_MESH_SELF=

# A MeshCore gateway instead of a directly driven radio: all three, or none. With them the
# daemon dials the gateway over loopback and learns nothing about presets or paths. A
# partial set is NOT a startup error: the mesh is disabled, the reason is printed, and
# the daemon keeps running.
#LDMUX_MESH_ADDR=127.0.0.1:41731
#LDMUX_MESH_TOKEN=
#LDMUX_MESH_PEER=

# ── The desktop and the shells ───────────────────────────────────────────────

# The terminal a desk window opens in: a free-form command line with `{cmd}` where the
# `ldmuxd attach` command goes and `{class}` where a window class goes. The order is
# LDMUX_TERMINAL_CMD, then LDMUX_TERMINAL, then $TERMINAL, then the known emulators on
# PATH.
#LDMUX_TERMINAL_CMD=alacritty --class {class} -e {cmd}

# One transient scope per shell under this slice, so a shell cannot take the keeper down
# with it. Default ldmux-shells.slice.
#LDMUX_SCOPE_SLICE=ldmux-shells.slice

# Turn the scopes off: a shell that cannot get a scope must still start. 1 disables them.
#LDMUX_NO_SCOPE=

# Scrollback per session. Both are overridable and neither can be silently zero.
#LDMUX_SCROLLBACK_LINES=10000
#LDMUX_SCROLLBACK_BYTES=41943040

# ── Paths and timing (rarely needed) ─────────────────────────────────────────

# The state directory: sockets, the registry cache, ownership claims. Under systemd the
# unit sets it to %t/ldmux, which is a tmpfs — correct for those, wrong for a credential.
#LDMUX_STATE_DIR=

# Where credentials persist across a reboot: the bearer token, the radio session key, the
# pinned phone key and the PSK. Default $XDG_STATE_HOME/ldmux, else ~/.local/state/ldmux.
#LDMUX_PERSIST_DIR=

# The tailnet bearer token file. Default <persist dir>/token; rotating the token means
# deleting this file and re-pairing every phone.
#LDMUX_TOKEN_FILE=

# The control socket, if not <state dir>/ldmuxd.sock.
#LDMUX_SOCK=

# Which systemd user unit runs the keeper (ADR-0021). Unset: the daemon spawns it detached.
#LDMUX_KEEPER_UNIT=ldmux-keeper.service

# How long a claim survives without a viewer before another device may take the shell
# (and how long a discovered session waits before it is shown).
#LDMUX_CLAIM_GRACE_MS=3000
# How often the claim sweep runs.
#LDMUX_CLAIM_TICK_MS=1000
# How long a claim in the saved file is honoured after a daemon restart, so a phone that
# is between retries does not lose its shell.
#LDMUX_RESTORE_GRACE_MS=60000
