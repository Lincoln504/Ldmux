# Copy to ~/.config/ldmux/env (the unit reads it if it exists), then edit.
# Plain KEY=VALUE lines, no quotes or `export`.
#
# The tailnet address this machine has (`tailscale ip -4`); the phone connects to
# it. Must be a tailnet or loopback address; unset means loopback only.
LDMUX_REMOTE_HOST=100.127.119.54
# The port. The code default is 7623; this machine's phone was paired with 7625,
# so it is set here rather than re-pairing.
LDMUX_REMOTE_PORT=7625
