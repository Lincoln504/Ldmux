# Copy to ~/.config/ldmux/env (the unit reads it if it exists), then edit.
# Plain KEY=VALUE lines, no quotes or `export`.
#
# The tailnet address this machine has (`tailscale ip -4`); the phone connects to
# it. Must be a tailnet or loopback address; unset means loopback only.
LDMUX_REMOTE_HOST=100.127.119.54
# The port. The code default is 7623; this machine's phone was paired with 7625,
# so it is set here rather than re-pairing.
LDMUX_REMOTE_PORT=7625

# ── LoRa / MeshCore (optional) ───────────────────────────────────────────────
#
# All of the first three, or none: a partial set is a startup error rather than a
# daemon that looks configured and is not. They come from the gateway's state file
# (`gatewayAddr`, `pairingToken`, `peerKey`), which is written when it is started —
# `docs/MESH-GATEWAY.md` and `docs/MESH-STANDALONE.md` are the record.
#LDMUX_MESH_ADDR=127.0.0.1:41731
#LDMUX_MESH_TOKEN=
#LDMUX_MESH_PEER=
#
# The pairing's pre-shared key (64 hex). Without it the L3 session is off and downlink
# records are dropped, with `last_error` saying so. It is persisted to `mesh-psk` (0600)
# in the state directory, so it only has to be given once.
#LDMUX_MESH_PSK=
#
# This host's own radio public key (64 hex). **A pairing code is not usable without it**:
# the phone needs to know which radio to address, and a code with no `hostRadio` sends it
# to `NeedsPeer`, which re-scanning the same code cannot fix. Unset, the key is read from
# the gateway's state file (`radioKey`).
#LDMUX_MESH_SELF=
