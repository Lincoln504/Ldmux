# ldmux daemon, as a systemd --user service.
#
# The daemon must outlive every session (docs/SPEC.md §4.3): a phone that puts
# its phone down, or a laptop that reboots the daemon, must not lose the shells
# that are running. That requires three things, and none is the default:
#
#   1. `KillMode=process` — see the note on it below. Without it a restart kills
#      the keeper, and every shell with it.
#   2. `loginctl enable-linger $USER` — **not a setting in this file, and the one
#      that is easiest to miss.** `WantedBy=default.target` starts the unit with the
#      user manager, and the user manager *stops on the last logout* unless linger is
#      on. Stopping it signals the whole user slice, which contains the keeper, so
#      every session dies, and `KillMode=process` does not help because the signal
#      does not come from this unit. Measured on this machine: `Linger=yes`.
#   3. Nothing else may stop the user manager: check `KillUserProcesses` in
#      `/etc/systemd/logind.conf` is not enabled.
#
# **Nothing machine-specific is in this file.** Per-machine values (the tailnet
# address the phone connects to, the port) go in an optional environment file,
# `~/.config/ldmux/env`, which the unit reads if it exists (`deploy/ldmux.env.example`
# is the template). With no `LDMUX_REMOTE_HOST` the daemon answers on the unix
# socket and loopback only: fine for the CLI, useless for a phone.
#
# **The desktop session's variables.** To open a desk window the daemon needs to
# know which desktop it is on (DISPLAY, WAYLAND_DISPLAY, XAUTHORITY, SWAYSOCK,
# I3SOCK, HYPRLAND_INSTANCE_SIGNATURE, NIRI_SOCKET, DBUS_SESSION_BUS_ADDRESS). A
# user unit starts with the user manager, possibly before login, so none are set
# here. The session passes them on at startup, once, from its own config:
#
#     systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XAUTHORITY \
#         SWAYSOCK I3SOCK HYPRLAND_INSTANCE_SIGNATURE NIRI_SOCKET DBUS_SESSION_BUS_ADDRESS
#
# (i3: `exec --no-startup-id systemctl --user import-environment …`; sway and
# hyprland: `exec`/`exec-once`; GNOME and KDE do it themselves.) The daemon asks
# the user manager for them when it has none of its own, so no restart is needed
# after the import. Without them `ldmux window` says there is no graphical session.
#
# **This file is a template.** `@BIN_DIR@` is replaced by scripts/install.sh with the
# absolute path of `~/.local/state/ldmux/current/bin`, a stable link to the installed
# binaries (a nix GC root when they came from `nix build`). The keeper is started by the
# daemon from the binary beside it, so all three binaries live in that one directory.
#
# Install with `nix run .#install` (nix-built binaries) or `scripts/install.sh [BIN_DIR]`
# (any directory holding ldmuxd, ldmux and ldmux-keeper): it links the binaries into
# `~/.local/bin`, and puts the rendered unit at `~/.config/systemd/user/ldmux.service`
# (beside it as `ldmux.service.new` when one is already there, unless FORCE=1), then
# runs `systemctl --user daemon-reload`. It does not enable or restart the unit:
# `systemctl --user enable --now ldmux` the first time, `restart` after that.
[Unit]
Description=ldmux daemon — remote terminal sessions
After=default.target

[Service]
Type=simple

# KillMode=process is the important line.
#
# The keeper, and therefore every shell in it, is *not* a child of this process —
# but it is in this unit's cgroup, because the daemon was what started it. The
# default KillMode=control-group signals the whole cgroup on stop, which kills the
# keeper and every session with it: measured, all sessions gone on a single
# `systemctl --user restart` (docs/DESKTOP-INTEGRATION.md). `process` signals only
# the daemon, and the shells survive it — which is the entire point of a
# kept-alive session. The keeper re-attaches on the daemon's next start.
KillMode=process

# A restart is a daemon restart, not a session wipe, so it is always safe to
# bring the daemon back: sessions are re-adopted from the keeper on boot
# (Registry.reconcile), never recreated.
Restart=on-failure
RestartSec=2

Environment=LDMUX_STATE_DIR=%t/ldmux

# The bearer token the phone is paired with. Not in the state directory: that is
# a tmpfs, so a token kept there was minted afresh on every boot and every paired
# phone was locked out. %S is ~/.local/state.
Environment=LDMUX_TOKEN_FILE=%S/ldmux/token


# Per-machine settings: LDMUX_REMOTE_HOST (the tailnet address the phone reaches),
# LDMUX_REMOTE_PORT (default 7623), and anything else the daemon reads. The leading
# dash makes the file optional. It is read after the Environment= lines above, so
# it can override any of them.
EnvironmentFile=-%h/.config/ldmux/env

# The binaries are named by absolute path (a window manager or the user manager may
# have no useful PATH), and the daemon finds its keeper beside itself. PATH here is only
# what the shells the daemon spawns see; `~/.local/bin` is first so `ldmux` is on it.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@BIN_DIR@/ldmuxd

[Install]
WantedBy=default.target