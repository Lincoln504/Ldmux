# ldmux daemon, as a systemd --user service.
#
# The daemon must outlive every session (docs/SPEC.md §4.3): a phone that puts
# its phone down, or a laptop that reboots the daemon, must not lose the shells
# that are running. That requires three things, and none is the default:
#
#   1. `KillMode=process` — see the note on it below. Without it a restart kills
#      the keeper, and every shell with it.
#   2. `loginctl enable-linger $USER` — **not a setting in this file, and the one
#      that is easiest to miss.** `WantedBy=default.target` starts the unit with the
#      user manager, and the user manager *stops on the last logout* unless linger is
#      on. Stopping it signals the whole user slice, which contains the keeper, so
#      every session dies, and `KillMode=process` does not help because the signal
#      does not come from this unit. Measured on this machine: `Linger=yes`.
#   3. Nothing else may stop the user manager: check `KillUserProcesses` in
#      `/etc/systemd/logind.conf` is not enabled.
#
# **THIS FILE IS THE DEPLOYED CONFIGURATION**, and it is machine-specific in three
# lines, each marked below. It used to be a template with those three commented out,
# which was worse than useless: installing it gave a loopback-only daemon that
# reported success and exited 0, so the phone could not connect and nothing said why.
# Install with `just install`: it installs the Rust binaries to `~/.local/bin`,
# copies this file to `~/.config/systemd/user/ldmux.service` and runs
# `systemctl --user daemon-reload`. It does not enable or restart the unit:
# `systemctl --user enable --now ldmux` the first time, `restart` after that.
[Unit]
Description=ldmux daemon — remote terminal sessions
# A real path, rather than one an installer that does not exist would have created.
Documentation=file://%h/Documents/ldmux/docs/SPEC.md
After=default.target

[Service]
Type=simple

# KillMode=process is the important line.
#
# The keeper, and therefore every shell in it, is *not* a child of this process —
# but it is in this unit's cgroup, because the daemon was what started it. The
# default KillMode=control-group signals the whole cgroup on stop, which kills the
# keeper and every session with it: measured, all sessions gone on a single
# `systemctl --user restart` (docs/DESKTOP-INTEGRATION.md). `process` signals only
# the daemon, and the shells survive it — which is the entire point of a
# kept-alive session. The keeper re-attaches on the daemon's next start.
KillMode=process

# A restart is a daemon restart, not a session wipe, so it is always safe to
# bring the daemon back: sessions are re-adopted from the keeper on boot
# (Registry.reconcile), never recreated.
Restart=on-failure
RestartSec=2

# The window manager's own environment, for "make it live on the desktop": the
# daemon launches a window through i3, and without DISPLAY and XAUTHORITY it can
# only report "no DISPLAY (not an X11 session)".
#
# User-specific, and an **override rather than a fallback**: a unit-level
# `Environment=` wins over `systemctl --user import-environment`, and
# `~/.config/i3/config` already imports the live DISPLAY/XAUTHORITY (docs/SPEC.md names
# that import as the mechanism). So on a session that is not `:0` the live-window path
# targets the wrong display and can only report the failure. It is kept because the
# unit starts with the user manager, which can precede i3's import, and `:0` is correct
# on this machine — measured: the session's DISPLAY is `:0.0`.
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority

Environment=LDMUX_STATE_DIR=%t/ldmux

# The bearer token the phone is paired with. Not in the state directory: that is
# a tmpfs, so a token kept there was minted afresh on every boot and every paired
# phone was locked out. %S is ~/.local/state.
Environment=LDMUX_TOKEN_FILE=%S/ldmux/token


# The daemon the phone talks to. Without these it answers on an unix socket only,
# which is fine for the CLI and useless for a device.
#
# Machine-specific: the tailnet address the phone reaches and the port the app is
# configured with. `ldmux remote` prints what this machine should use.
Environment=LDMUX_REMOTE_HOST=100.127.119.54
Environment=LDMUX_REMOTE_PORT=7625

# `~/.local/bin` is where `just install` puts ldmuxd, ldmux and ldmux-keeper. The
# daemon auto-spawns the keeper by name, so it must be on PATH. Nothing here comes
# from a nix profile: the daemon is a cargo build, and `just install` keeps a GC
# root for the C library it links against.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ldmuxd

[Install]
WantedBy=default.target