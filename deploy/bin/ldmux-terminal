#!/bin/sh
# A terminal keybinding must always give a terminal.
#
# **This wrapper opens the terminal; ldmux runs inside it.** `ldmux` never opens a window of
# its own for a person at a keyboard: `ldmux shell` becomes the desk window in whatever
# terminal it is started in, so the emulator is this script's child and the session is
# `ldmux shell`'s. The only window the daemon opens is the one the phone asks for
# (`send to desktop`), where there is no terminal already.
#
# The emulator is the one you configured, resolved by the daemon so the chain lives in one
# place (`desktop.rs`): $TERMINAL, then xdg-terminal-exec, then your desktop's own setting,
# then an emulator already running for your user. `ldmux terminal --exec <command>` applies
# that emulator's own template (`-e`, `--wait`, `--class`) and replaces this process with it.
#
# Usage: ldmux-terminal [directory]     (default: the current directory)
#
# It waits for the daemon before opening anything. A window opened at login used to lose the
# race with the daemon by a couple of seconds and drop straight to a plain shell, which is
# not a session and which no client can see; the fallback is logged rather than silent.
#
# POSIX sh. Whatever launches this (a window manager, a desktop entry) may have a PATH
# without ~/.local/bin, so it is added here.
PATH="$PATH:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export PATH

if [ -n "${LDMUX:-}" ]; then
  LDMUX_BIN="$LDMUX"
elif [ -x "$HOME/.local/bin/ldmux" ]; then
  LDMUX_BIN="$HOME/.local/bin/ldmux"
else
  LDMUX_BIN=$(command -v ldmux 2>/dev/null || true)
fi

dir="${1:-${PWD:-$HOME}}"

# The daemon has to answer before a session can exist. `ping` is the cheapest question.
up=0
if [ -n "$LDMUX_BIN" ]; then
  tries=0
  while [ "$tries" -lt 12 ]; do
    if "$LDMUX_BIN" ping >/dev/null 2>&1; then
      up=1
      break
    fi
    tries=$((tries + 1))
    sleep 0.25 2>/dev/null || sleep 1
  done
else
  echo "ldmux binary not found (looked at \$LDMUX, ~/.local/bin/ldmux, PATH)" >&2
fi

if [ "$up" = 1 ]; then
  exec "$LDMUX_BIN" terminal --exec "$LDMUX_BIN" shell "$dir"
fi

msg="no ldmux daemon, plain terminal instead"
if command -v logger >/dev/null 2>&1; then
  logger -t ldmux-terminal "$msg"
else
  echo "ldmux-terminal: $msg" >&2
fi

term=""
if [ -n "$LDMUX_BIN" ]; then
  term=$("$LDMUX_BIN" terminal 2>/dev/null) || term=""
fi
if [ -z "$term" ]; then
  first=${TERMINAL:-x-terminal-emulator}
  # shellcheck disable=SC2086
  set -- $first
  term=$(command -v "$1" 2>/dev/null) || term=""
fi
[ -n "$term" ] || {
  echo "ldmux-terminal: no terminal emulator found; set \$TERMINAL to one" >&2
  exit 1
}
exec "$term"
