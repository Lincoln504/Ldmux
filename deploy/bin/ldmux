#!/bin/sh
# ldmux CLI. A wrapper, not a build step: the daemon and protocol packages are
# TypeScript and Node runs them directly (ADR-0009, no build step).
#
# Installed by `just install`, which replaces @REPO@. Node and tmux come from the
# flake's runtime (`nix build .#runtime`, linked at ~/.local/state/ldmux/runtime):
# the same versions the suite runs, and by absolute path, because this is run from
# i3 whose PATH has neither — a bare `node` there made every desk window a plain
# shell for days.
RUNTIME=${XDG_STATE_HOME:-$HOME/.local/state}/ldmux/runtime
export LDMUX_TMUX_BIN="$RUNTIME/bin/tmux"
exec "$RUNTIME/bin/node" @REPO@/packages/daemon/src/cli.ts "$@"
