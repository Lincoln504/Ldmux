#!/bin/sh
# ldmux daemon entry point. Referenced by the systemd --user unit as
# ExecStart=%h/.local/bin/ldmuxd. node by absolute path, as in `ldmux`.
NODE=${LDMUX_NODE:-/home/ldeen/.config/nvm/versions/node/v25.8.2/bin/node}
exec "$NODE" /home/ldeen/Documents/ldmux/packages/daemon/src/main.ts "$@"
